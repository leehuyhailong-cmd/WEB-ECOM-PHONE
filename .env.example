# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/phonestore

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be >= 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_char_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_random_64_char_string_for_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Session (for Passport / Google OAuth) ────────────────────────────────────
SESSION_SECRET=replace_with_a_random_64_char_string_for_sessions

# ─── Google OAuth2 (Phase 2) ──────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── Cloudinary (Phase 3 — Product Images) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── OpenAI (Phase 6 — AI Chatbot) ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── VNPay Sandbox (Phase 4 — Payment) ───────────────────────────────────────
# Get from: https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
